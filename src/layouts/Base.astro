---
import '@fontsource/press-start-2p';
import '../styles/global.css';
import AccountBar from '../components/AccountBar.astro';
import Footer from '../components/Footer.astro';
import WipBubble from '../components/WipBubble.astro';

interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'CUDGS | Cambridge University Digital Gaming Society',
    description = 'Cambridge University Digital Gaming Society',
} = Astro.props;
const base = import.meta.env.BASE_URL;

// Cookieless visitor stats (self-hosted Umami). Only counts visits on the real domains, never
// localhost, and respects Do Not Track; visitors can opt out on the privacy page.
const umamiScript = import.meta.env.PUBLIC_UMAMI_SCRIPT;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Bump ?v= when the icons change: browsers cache favicons very aggressively. -->
    <link rel="icon" href={base + 'favicon.svg?v=2'} type="image/svg+xml" />
    <link rel="icon" href={base + 'favicon-32.png?v=2'} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={base + 'apple-touch-icon.png?v=2'} />
    <meta name="theme-color" content="#0E1116" />
    {umamiScript && umamiWebsiteId && (
        <script
            is:inline
            defer
            src={umamiScript}
            data-website-id={umamiWebsiteId}
            data-domains="cudgs.obby.page,cudgs.org,www.cudgs.org"
            data-do-not-track="true"
        ></script>
    )}
</head>
<body>
    <div class="page">
        <AccountBar />
        <main>
            <slot />
        </main>
        <Footer />
    </div>
    <WipBubble />
</body>
</html>
