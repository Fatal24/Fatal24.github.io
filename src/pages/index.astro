---
import Base from '../layouts/Base.astro';
import SlantedSection from '../components/SlantedSection.astro';
import Events from '../components/Events.astro';
import Committee from '../components/Committee.astro';
import Sponsors from '../components/Sponsors.astro';
import logo from '../assets/logo-text.svg?raw';
import redbullPhoto from '../assets/photos/varsity-2025-redbull.jpg';
import playerPhoto from '../assets/photos/varsity-player.jpg';
import gamesPoster from '../assets/photos/games-poster.jpg';

// Icons are hand-drawn Wiggly gifs in public/icons (black lines on transparent),
// used as a mask so they can be painted in the palette colour.
const socials = [
    { label: 'CUDGS on Instagram', href: 'https://www.instagram.com/camdigitalgaming', gif: 'icons/instagram.gif' },
    { label: 'Join the CUDGS Discord server', href: 'https://discord.gg/P2TthJCgu2', gif: 'icons/discord.gif' },
];
---

<Base>
    <header>
        <div class="logo" aria-hidden="true" set:html={logo} />
        <h1>Cambridge University Digital Gaming Society</h1>
        <nav class="socials" aria-label="Social links">
            {socials.map(({ label, href, gif }, i) => (
                <a
                    class="btn"
                    href={href}
                    aria-label={label}
                    title={label}
                    style={`--i: ${i}; --icon: url('${import.meta.env.BASE_URL + gif}')`}
                >
                    <span class="wiggly" aria-hidden="true"></span>
                </a>
            ))}
        </nav>
    </header>

    <Sponsors />

    <SlantedSection title="Events" image={redbullPhoto}>
        <Events />
    </SlantedSection>

    <!-- 12s loop from obby's "mmmmmmm valorant" (youtu.be/BK8cz1E9Qic), from 0:41.6, no audio. -->
    <SlantedSection title="Games" variant="indigo" video="videos/games.mp4" poster={gamesPoster}>
        <ul class="games">
            <li>Overwatch</li>
            <li>Valorant</li>
            <li>CS2</li>
            <li>Minecraft</li>
        </ul>
    </SlantedSection>

    <SlantedSection title="About Us">
        <p>whatever we want to say about us</p>
    </SlantedSection>

    <SlantedSection title="Committee" variant="indigo" image={playerPhoto}>
        <Committee />
    </SlantedSection>
</Base>

<style>
    /* Full logo (lion + name) on the left, spanning the title and the socials; the title keeps
       its pixel font beside it. Everything stacks on narrow screens. */
    header {
        --title-size: clamp(1.4rem, 0.9rem + 2.5vw, 3rem);
        --icon-size: clamp(4.5rem, 10vw, 6.5rem); /* matches .btn */
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-areas:
            "logo title"
            "logo socials";
        align-items: start;
        column-gap: clamp(1rem, 3vw, 2rem);
        row-gap: 1.25rem;
        margin-bottom: clamp(1rem, 3vw, 2rem);
    }

    @media (max-width: 40rem) {
        header {
            grid-template-columns: 1fr;
            grid-template-areas: "logo" "title" "socials";
        }
    }

    .logo {
        grid-area: logo;
        /* As tall as the 4-line title plus the socials row; the logo is 0.873x as wide as tall. */
        width: calc(0.873 * (5 * var(--title-size) + 1.25rem + var(--icon-size)));
        color: var(--cam-blue);
        filter: drop-shadow(4px 4px 0 var(--cam-dark-blue));
    }

    @media (max-width: 40rem) {
        .logo {
            width: 12rem;
        }
    }

    .logo :global(svg) {
        display: block;
        width: 100%;
        height: auto;
    }

    h1 {
        grid-area: title;
        margin: 0;
        font-size: var(--title-size);
        line-height: 1.25;
        color: var(--cam-blue);
        text-shadow: 3px 3px 0 var(--cam-dark-blue);
    }

    .socials {
        grid-area: socials;
        display: flex;
        gap: clamp(1rem, 3vw, 2rem);
    }

    /* No box: the drawing is the button.
       Motion copies zanelittle.com's two Construct Sine behaviours (averaged, minus the randomness):
       a vertical bob on the link and a rocking rotation on the drawing inside it. */
    .btn {
        --bob-period: 5.5s;
        --rock-period: 3s;
        /* easeInOutSine between the two extremes traces an exact sine wave. */
        --sine: cubic-bezier(0.37, 0, 0.63, 1);
        display: grid;
        width: clamp(4.5rem, 10vw, 6.5rem);
        aspect-ratio: 1;
        border-radius: 0.75rem;
        /* The shadow sits on the link because the mask below would clip it off the icon. */
        filter: drop-shadow(3px 3px 0 var(--indigo));
        /* Each icon runs a quarter-cycle behind the one before it, so they move as a wave. */
        animation: bob var(--bob-period) var(--sine) calc(var(--i) * var(--bob-period) / -4) infinite;
        transition: scale 0.2s, filter 0.2s;
    }

    /* Keep keyframe values literal: Chrome drops `translate`/`rotate` keyframes that use var(). */
    /* ±15% of the icon's own size, so it scales with the page (~±15px at full size). */
    @keyframes bob {
        0%, 100% { translate: 0 -15%; }
        50% { translate: 0 15%; }
    }

    @keyframes rock {
        0%, 100% { rotate: -7.5deg; }
        50% { rotate: 7.5deg; }
    }

    .btn:hover,
    .btn:focus-visible {
        scale: 1.1;
        filter: drop-shadow(3px 3px 0 var(--indigo)) drop-shadow(0 0 0.6rem rgb(255 255 255 / 0.5));
    }

    .btn:focus-visible {
        outline: 3px solid white;
        outline-offset: 4px;
    }

    /* The gif is a mask, so its black lines are painted Cambridge Blue (with the Indigo
       shadow above as the accent) and turn white on hover. */
    .wiggly {
        background-color: var(--cam-blue);
        mask: var(--icon) center / contain no-repeat;
        animation: rock var(--rock-period) var(--sine) calc(var(--i) * var(--rock-period) / -4) infinite;
        transition: background-color 0.2s;
    }

    .btn:hover .wiggly,
    .btn:focus-visible .wiggly {
        background-color: white;
    }

    .games {
        margin: 0;
        padding-left: 1.5rem;
        list-style: square;
    }

    p {
        margin: 0;
    }
</style>
