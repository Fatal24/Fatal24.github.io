---
import { siDiscord, siInstagram } from 'simple-icons';
import SlantedSection from '../components/SlantedSection.astro';
import Events from '../components/Events.astro';
import '../styles/global.css';

const socials = [
    { label: 'Instagram', href: 'https://www.instagram.com/camdigitalgaming', icon: siInstagram },
    { label: 'Discord', href: 'https://discord.gg/zb2YUQEdUB', icon: siDiscord },
];
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CUDGS | Cambridge University Digital Gaming Society</title>
    <meta name="description" content="Cambridge University Digital Gaming Society" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
</head>
<body>
    <main class="page">
        <header>
            <h1>Cambridge University Digital Gaming Society</h1>
            <nav class="socials" aria-label="Social links">
                {socials.map(({ label, href, icon }) => (
                    <a class="btn" href={href} aria-label={label}>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.path} /></svg>
                    </a>
                ))}
            </nav>
        </header>

        <SlantedSection title="Events">
            <Events />
        </SlantedSection>

        <SlantedSection title="Games" variant="magenta">
            <ul class="games">
                <li>Overwatch</li>
                <li>Valorant</li>
                <li>CS2</li>
                <li>Minecraft</li>
            </ul>
        </SlantedSection>

        <SlantedSection title="About Us">
            <p>whatever we want to say about us</p>
        </SlantedSection>
    </main>
</body>
</html>

<style>
    header {
        margin-bottom: clamp(1rem, 3vw, 2rem);
    }

    h1 {
        margin: 0 0 1.25rem;
        font-size: clamp(1.4rem, 0.9rem + 2.5vw, 3rem);
        line-height: 1.25;
        color: var(--teal);
        text-shadow: 3px 3px 0 var(--dark_teal);
    }

    .socials {
        display: flex;
        gap: 0.75rem;
    }

    .btn {
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        padding: 0.7rem;
        border: 2px solid var(--teal);
        border-radius: 0.75rem;
        color: var(--teal);
        background: var(--dark_teal);
        transition: background-color 0.2s, color 0.2s, transform 0.2s;
    }

    .btn:hover,
    .btn:focus-visible {
        color: var(--dark_teal);
        background: var(--teal);
        transform: translateY(-2px);
    }

    .btn svg {
        width: 100%;
        height: 100%;
        fill: currentColor;
    }

    .games {
        margin: 0;
        padding-left: 1.5rem;
        list-style: square;
    }

    p {
        margin: 0;
    }
</style>
