---
// Events without their own picture (a Drive attachment or an "Image:" line) show no picture area,
// so their cards are only as tall as their text.
---

<div class="carousel">
    <button class="arrow prev" type="button" aria-label="Previous events" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
    </button>
    <ul class="track" aria-live="polite">
        <li class="status">Loading events…</li>
    </ul>
    <button class="arrow next" type="button" aria-label="Next events" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
    </button>
</div>

<template id="event-card">
    <li class="card">
        <div class="media">
            <img alt="" loading="lazy" decoding="async" />
        </div>
        <h3 class="name"></h3>
        <div class="chips">
            <span class="chip">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2" /><path d="M3 10h18M8 2v4M16 2v4" /></svg>
                <span class="date"></span>
            </span>
            <span class="chip">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                <span class="time"></span>
            </span>
            <a class="chip location" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
                <span class="place"></span>
            </a>
        </div>
        <p class="description"></p>
        <button class="more" type="button" hidden>More</button>
        <div class="actions">
            <a class="action signup" target="_blank" rel="noopener" hidden>Sign up</a>
            <a class="action gcal" target="_blank" rel="noopener">+ Google Calendar</a>
            <button class="action ics" type="button">+ Apple / Outlook (.ics)</button>
        </div>
    </li>
</template>

<script>
    const HOUR = 1000 * 60 * 60;

    // Events come from the society's public Google Calendar (see .env.example).
    const calendarId = import.meta.env.PUBLIC_GOOGLE_CALENDAR_ID;
    const apiKey = import.meta.env.PUBLIC_GOOGLE_API_KEY;

    type EventTime = { dateTime?: string; date?: string };
    type CalendarEvent = {
        id: string;
        summary?: string;
        location?: string;
        description?: string;
        // Timed events have dateTime; all-day events have date (YYYY-MM-DD, end is exclusive).
        start: EventTime;
        end: EventTime;
        attachments?: { fileId?: string; mimeType?: string }[];
    };

    // Descriptions written in Google Calendar's editor can contain HTML; read it as plain text.
    // DOMParser never runs scripts, and the result is only ever used as textContent.
    const toText = (html: string) =>
        new DOMParser().parseFromString(html.replace(/<br\s*\/?>/gi, '\n'), 'text/html').body.textContent ?? '';

    // Lines like "Image: https://..." or "Sign up: https://..." become the card picture or a
    // button instead of being shown as text.
    const LINK_LINE = /^\s*(image|sign ?up|rsvp|tickets?)\s*:\s*(https?:\/\/\S+)\s*$/gim;
    function splitLinks(text: string) {
        const links: { image?: string; signup?: string } = {};
        const rest = text.replace(LINK_LINE, (_, kind: string, url: string) => {
            if (kind.toLowerCase() === 'image') links.image = url;
            else links.signup = url;
            return '';
        });
        return { links, text: rest.replace(/\n{3,}/g, '\n\n').trim() };
    }

    // A poster attached from Google Drive (shared "Anyone with the link") beats an Image: line;
    // Drive serves a resized thumbnail for it.
    function driveImage(event: CalendarEvent) {
        const file = event.attachments?.find((a) => a.fileId && a.mimeType?.startsWith('image/'));
        return file && `https://drive.google.com/thumbnail?id=${encodeURIComponent(file.fileId!)}&sz=w1000`;
    }

    const allDay = (event: CalendarEvent) => !event.start.dateTime;
    const startOf = (event: CalendarEvent) => new Date(event.start.dateTime ?? `${event.start.date}T00:00:00`);
    const endOf = (event: CalendarEvent) => new Date(event.end.dateTime ?? `${event.end.date}T00:00:00`);
    const clock = (date: Date) => date.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });

    // Calendar formats: UTC "20261001T123000Z" for timed events, "20261001" for all-day ones.
    const utcStamp = (date: Date) => date.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    const dayStamp = (ymd: string) => ymd.replace(/-/g, '');
    const calendarDates = (event: CalendarEvent) =>
        allDay(event)
            ? [dayStamp(event.start.date!), dayStamp(event.end.date!)]
            : [utcStamp(startOf(event)), utcStamp(endOf(event))];

    function googleCalendarUrl(event: CalendarEvent, details: string) {
        const url = new URL('https://calendar.google.com/calendar/render');
        url.search = new URLSearchParams({
            action: 'TEMPLATE',
            text: event.summary ?? 'CUDGS event',
            dates: calendarDates(event).join('/'),
            details,
            location: event.location ?? '',
        }).toString();
        return url.toString();
    }

    function downloadIcs(event: CalendarEvent, details: string) {
        const escape = (s: string) => s.replace(/[\\;,]/g, (c) => `\\${c}`).replace(/\n/g, '\\n');
        const [start, end] = calendarDates(event);
        const when = allDay(event) ? [`DTSTART;VALUE=DATE:${start}`, `DTEND;VALUE=DATE:${end}`] : [`DTSTART:${start}`, `DTEND:${end}`];
        const ics = [
            'BEGIN:VCALENDAR',
            'VERSION:2.0',
            'PRODID:-//CUDGS//Website//EN',
            'BEGIN:VEVENT',
            `UID:${event.id}@cudgs`,
            `DTSTAMP:${utcStamp(new Date())}`,
            ...when,
            `SUMMARY:${escape(event.summary ?? 'CUDGS event')}`,
            ...(event.location ? [`LOCATION:${escape(event.location)}`] : []),
            ...(details ? [`DESCRIPTION:${escape(details)}`] : []),
            'END:VEVENT',
            'END:VCALENDAR',
        ].join('\r\n');
        const link = document.createElement('a');
        link.href = URL.createObjectURL(new Blob([ics], { type: 'text/calendar' }));
        link.download = `${(event.summary ?? 'cudgs-event').replace(/[^\w-]+/g, '-').toLowerCase()}.ics`;
        link.click();
        setTimeout(() => URL.revokeObjectURL(link.href), 1000);
    }

    const carousel = document.querySelector<HTMLElement>('.carousel')!;
    const track = carousel.querySelector<HTMLUListElement>('.track')!;
    const prev = carousel.querySelector<HTMLButtonElement>('.prev')!;
    const next = carousel.querySelector<HTMLButtonElement>('.next')!;
    const template = document.querySelector<HTMLTemplateElement>('#event-card')!;

    function showStatus(message: string) {
        const li = document.createElement('li');
        li.className = 'status';
        li.textContent = message;
        track.replaceChildren(li);
    }

    function renderCard(event: CalendarEvent) {
        const card = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
        const start = startOf(event);
        const end = endOf(event);
        const { links, text } = splitLinks(toText(event.description ?? ''));

        const media = card.querySelector<HTMLElement>('.media')!;
        const src = driveImage(event) || links.image;
        if (src) {
            const img = media.querySelector('img')!;
            img.src = src;
            // A broken or unshared picture drops the picture area rather than showing an empty box.
            img.addEventListener('error', () => media.remove(), { once: true });
        } else {
            media.remove();
        }

        card.querySelector('.name')!.textContent = event.summary || 'Untitled event';
        card.querySelector('.date')!.textContent = start.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
        card.querySelector('.time')!.textContent = allDay(event)
            ? 'All day'
            : start.toDateString() === end.toDateString() ? `${clock(start)}–${clock(end)}` : clock(start);

        // Show just the venue ("Sidney Sussex College"); the full address is the tooltip and map link.
        const location = card.querySelector<HTMLAnchorElement>('.location')!;
        if (event.location) {
            card.querySelector('.place')!.textContent = event.location.split(',')[0].trim();
            location.title = `${event.location} (opens Google Maps)`;
            location.href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(event.location)}`;
        } else {
            location.remove();
        }

        const description = card.querySelector<HTMLElement>('.description')!;
        if (text) description.textContent = text;
        else description.remove();

        const signup = card.querySelector<HTMLAnchorElement>('.signup')!;
        if (links.signup) {
            signup.href = links.signup;
            signup.hidden = false;
        }
        card.querySelector<HTMLAnchorElement>('.gcal')!.href = googleCalendarUrl(event, text);
        card.querySelector('.ics')!.addEventListener('click', () => downloadIcs(event, text));
        return card;
    }

    // Long descriptions are cut to a few lines with a "More" toggle; this needs layout, so it
    // runs once the cards are on the page.
    function addMoreButtons() {
        for (const card of track.querySelectorAll<HTMLElement>('.card')) {
            const description = card.querySelector<HTMLElement>('.description');
            const more = card.querySelector<HTMLButtonElement>('.more')!;
            if (!description || description.scrollHeight <= description.clientHeight + 1) continue;
            more.hidden = false;
            more.addEventListener('click', () => {
                const expanded = description.classList.toggle('expanded');
                more.textContent = expanded ? 'Less' : 'More';
            });
        }
    }

    function updateArrows() {
        const overflowing = track.scrollWidth > track.clientWidth + 1;
        prev.hidden = next.hidden = !overflowing;
        prev.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    }

    const step = () => track.clientWidth * 0.8;
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', updateArrows, { passive: true });
    new ResizeObserver(updateArrows).observe(track);

    try {
        if (!calendarId || !apiKey) throw new Error('PUBLIC_GOOGLE_CALENDAR_ID / PUBLIC_GOOGLE_API_KEY are not set');
        const url = new URL(`https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(calendarId)}/events`);
        url.search = new URLSearchParams({
            key: apiKey,
            // Keep an event listed until 8 hours after it ends.
            timeMin: new Date(Date.now() - 8 * HOUR).toISOString(),
            singleEvents: 'true', // expand repeating events into individual dates
            orderBy: 'startTime',
            maxResults: '20',
        }).toString();
        const response = await fetch(url);
        if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
        const { items: upcoming = [] }: { items?: CalendarEvent[] } = await response.json();
        if (upcoming.length === 0) showStatus('No upcoming events right now. Check the Discord for news!');
        else {
            track.replaceChildren(...upcoming.map(renderCard));
            requestAnimationFrame(addMoreButtons);
        }
    } catch (error) {
        console.error('Error:', error);
        showStatus("Couldn't load events. Check the Discord for what's on!");
    }
    updateArrows();
</script>

<style>
    .carousel {
        position: relative;
    }

    .track {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin: 0;
        padding: 0.25rem 0 1rem;
        list-style: none;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        scrollbar-color: var(--black) transparent;
    }

    .status {
        padding: 1rem 0;
    }

    .card {
        flex: 0 0 min(85%, 20rem);
        scroll-snap-align: start;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 0.75rem;
        border-radius: 0.75rem;
        color: white;
        background: var(--black);
    }

    .media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 0.5rem;
        background: var(--cam-dark-blue);
    }

    .media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .name {
        margin: 0;
        font-size: 0.9em;
        line-height: 1.5;
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        font-size: 0.7em;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        max-width: 100%;
        padding: 0.3rem 0.55rem;
        border-radius: 0.4rem;
        color: inherit;
        background: rgb(255 255 255 / 0.15);
        white-space: nowrap;
        text-decoration: none;
    }

    .place {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    a.chip:hover,
    a.chip:focus-visible {
        color: var(--black);
        background: var(--cam-blue);
    }

    .description {
        display: -webkit-box;
        margin: 0;
        overflow: hidden;
        font-size: 0.65em;
        line-height: 1.8;
        white-space: pre-line;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 4;
        line-clamp: 4;
    }

    .description.expanded {
        display: block;
    }

    .more {
        align-self: flex-start;
        padding: 0;
        border: 0;
        font: inherit;
        font-size: 0.6em;
        color: var(--cam-blue);
        background: none;
        text-decoration: underline;
        cursor: pointer;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-top: auto;
        font-size: 0.6em;
    }

    .action {
        padding: 0.45rem 0.6rem;
        border: 2px solid var(--cam-blue);
        border-radius: 0.4rem;
        font: inherit;
        color: var(--cam-blue);
        background: none;
        text-decoration: none;
        cursor: pointer;
    }

    .action:hover,
    .action:focus-visible,
    .signup {
        color: var(--black);
        background: var(--cam-blue);
    }

    .signup[hidden] {
        display: none;
    }

    svg {
        width: 1.1em;
        height: 1.1em;
        flex: none;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .arrow {
        position: absolute;
        top: 50%;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        padding: 0;
        border: 0;
        border-radius: 50%;
        color: white;
        background: rgb(14 17 22 / 0.85);
        cursor: pointer;
        transform: translateY(-50%);
        transition: background-color 0.2s, opacity 0.2s;
    }

    .arrow[hidden] {
        display: none;
    }

    .arrow:hover {
        background: var(--indigo);
    }

    .arrow:disabled {
        opacity: 0;
        pointer-events: none;
    }

    .arrow svg {
        width: 1.4rem;
        height: 1.4rem;
    }

    .prev {
        left: 0.5rem;
    }

    .next {
        right: 0.5rem;
    }
</style>
