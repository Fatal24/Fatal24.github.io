---
interface Props {
    title: string;
    variant?: 'blue' | 'indigo';
}

const { title, variant = 'blue' } = Astro.props;
---

<section class:list={['slanted', variant]}>
    <h2>{title}</h2>
    <slot />
</section>

<style>
    .slanted {
        position: relative;
        margin-block: clamp(1.5rem, 4vw, 2.5rem);
        /* Vertical padding clears the slanted edges; horizontal padding keeps text off the sides. */
        padding: calc(var(--slant) + clamp(1.25rem, 3vw, 2rem)) clamp(1.25rem, 4vw, 2.5rem);
    }

    .blue {
        color: var(--black);
        background: var(--cam-blue);
        clip-path: polygon(0 0, 100% var(--slant), 100% calc(100% - var(--slant)), 0 100%);
    }

    .indigo {
        color: white;
        background: var(--indigo);
        clip-path: polygon(0 var(--slant), 100% 0, 100% 100%, 0 calc(100% - var(--slant)));
    }

    h2 {
        margin: 0 0 1rem;
        font-size: clamp(1rem, 0.8rem + 1vw, 1.5rem);
        line-height: 1.4;
        text-shadow: 2px 2px 0 var(--cam-warm-blue);
    }

    .indigo h2 {
        text-shadow: 2px 2px 0 var(--dark-indigo);
    }
</style>
