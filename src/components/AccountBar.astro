---
// Top-right account area. Pages are mostly static, so it asks /api/me who is signed in.
const base = import.meta.env.BASE_URL;

// Member login via Nevar (the SRCF's University Account login; key 501, approved September 2026).
// Set to false to show the "WIP, sorry" bubble (WipBubble.astro) instead of logging in.
const loginReady = true;

// No point linking to Members from the Members page itself.
const onMembers = Astro.url.pathname.replace(/\/$/, '').endsWith('/members');
// The home page already has the big logo, so the small home button only appears on other pages.
const onHome = Astro.url.pathname.replace(/\/$/, '') === base.replace(/\/$/, '');
---

<div class="account" data-state="loading">
    {!onHome && (
        <a class="home" href={base} aria-label="CUDGS home" title="CUDGS home">
            <img src={base + 'favicon.svg'} alt="" width="48" height="48" />
        </a>
    )}
    <a
        class:list={['raven', { wip: !loginReady }]}
        href={base + 'login'}
        aria-label={loginReady ? 'Log in with your University Account (Raven)' : 'Log in with your University Account (Raven), coming soon'}
        title={loginReady ? 'Log in with your University Account (Raven)' : 'Member login: coming soon'}
        style={`--icon: url('${base}icons/raven.gif')`}
    >
        <span class="wiggly" aria-hidden="true"></span>
    </a>
    <div class="signed-in">
        <span class="hello">Hello, <span class="who"></span>!</span>
        {!onMembers && <a class="button" href={base + 'members'}>Members</a>}
        <form method="post" action={base + 'logout'}>
            <button class="button" type="submit">Log out</button>
        </form>
    </div>
</div>

<script>
    const account = document.querySelector<HTMLElement>('.account')!;
    const who = account.querySelector<HTMLElement>('.who')!;

    try {
        const response = await fetch(`${import.meta.env.BASE_URL}api/me`, { credentials: 'same-origin' });
        const me = response.ok ? await response.json() : null;
        if (me?.signedIn) {
            who.textContent = me.firstName ?? me.crsid;
            account.dataset.state = 'signed-in';
        } else {
            account.dataset.state = 'signed-out';
        }
    } catch {
        account.dataset.state = 'signed-out';
    }

</script>

<style>
    .account {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 1rem;
        min-height: 4.5rem;
        margin-bottom: 1rem;
        font-size: 0.75rem;
    }

    /* The plain CUDGS lion, top left on every page, back to the home page. */
    .home {
        margin-right: auto;
        border-radius: 0.5rem;
        transition: scale 0.2s, filter 0.2s;
    }

    .home img {
        display: block;
        width: clamp(2.75rem, 6vw, 3.5rem);
        height: auto;
        filter: drop-shadow(3px 3px 0 var(--indigo));
    }

    .home:hover,
    .home:focus-visible {
        scale: 1.08;
    }

    .home:focus-visible {
        outline: 3px solid white;
        outline-offset: 4px;
    }

    .signed-in {
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.75rem 1rem;
    }

    .signed-in form {
        margin: 0;
    }

    /* Outlined pixel buttons, matching the event and privacy-page buttons. */
    .button {
        display: inline-block;
        padding: 0.55rem 0.8rem;
        border: 2px solid var(--cam-blue);
        border-radius: 0.5rem;
        font: inherit;
        font-size: 0.65rem;
        line-height: 1.4;
        color: var(--cam-blue);
        background: rgb(14 17 22 / 0.6);
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s, color 0.2s;
    }

    .button:hover,
    .button:focus-visible {
        color: var(--black);
        background: var(--cam-blue);
    }

    .hello {
        color: white;
    }

    .raven,
    .signed-in {
        display: none;
    }

    [data-state='signed-out'] .raven {
        display: grid;
    }

    [data-state='signed-in'] .signed-in {
        display: flex;
    }

    /* Same hand-drawn mask treatment as the social icons. */
    .raven {
        height: clamp(3.5rem, 8vw, 4.5rem);
        aspect-ratio: 355 / 261;
        filter: drop-shadow(3px 3px 0 var(--indigo));
        transition: scale 0.2s, filter 0.2s;
    }

    .raven:hover,
    .raven:focus-visible {
        scale: 1.1;
        filter: drop-shadow(3px 3px 0 var(--indigo)) drop-shadow(0 0 0.6rem rgb(255 255 255 / 0.5));
    }

    .raven:focus-visible {
        outline: 3px solid white;
        outline-offset: 4px;
    }

    .wiggly {
        background-color: var(--cam-blue);
        mask: var(--icon) center / contain no-repeat;
        transition: background-color 0.2s;
    }

    .raven:hover .wiggly,
    .raven:focus-visible .wiggly {
        background-color: white;
    }
</style>
