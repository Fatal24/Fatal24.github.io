# Copy to .env and fill in. Never commit .env or anything in secrets/.

# Public URL of the site, used for the login callback (must match exactly what visitors use).
SITE_URL=http://localhost:4321

# Long random string for signing login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Nevar's public signing key: ask the SRCF sysadmins for it (contact details on srcf.net).
# Save it as a PEM file and give its key id (the "kid" Nevar signs with).
NEVAR_KEY_ID=
NEVAR_KEY_FILE=secrets/nevar.pem

# Members sheet (private; shared only with the service account's email as Viewer).
# The ID is the long part of the sheet URL between /d/ and /edit.
MEMBERS_SHEET_ID=
MEMBERS_SHEET_RANGE=Members!A:D
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# Baserow token for the public events list. It ends up in visitors' browsers, so it must be
# a read-only token limited to the events table, and never one that can see member data.
PUBLIC_BASEROW_TOKEN=
