# Copy to .env and fill in. Never commit .env or anything in secrets/.

# Public URL of the site, used for the login callback (must match exactly what visitors use).
SITE_URL=http://localhost:4321

# Long random string for signing login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Nevar's public signing key: ask the SRCF sysadmins for it (contact details on srcf.net).
# Save it as a PEM file and give its key id (the "kid" Nevar signs with).
NEVAR_KEY_ID=
NEVAR_KEY_FILE=secrets/nevar.pem

# Members sheet (private; shared only with the service account's email as Viewer).
# The ID is the long part of the sheet URL between /d/ and /edit.
MEMBERS_SHEET_ID=
MEMBERS_SHEET_RANGE=Members!A:D
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# Events come from the society's Google Calendar, which must be public
# (Calendar settings > Access permissions > Make available to public > See all event details).
# The calendar ID is under Settings > Integrate calendar.
PUBLIC_GOOGLE_CALENDAR_ID=
# Google Cloud console: enable the Google Calendar API, create an API key, and restrict it to
# the Calendar API and to this site's address (HTTP referrers). It is visible in visitors' browsers.
PUBLIC_GOOGLE_API_KEY=

# Visitor stats (self-hosted Umami at webstats.obby.page). Leave blank to disable.
PUBLIC_UMAMI_SCRIPT=https://webstats.obby.page/script.js
PUBLIC_UMAMI_WEBSITE_ID=2c98b351-b869-49e4-960c-23be8d3e90ae
